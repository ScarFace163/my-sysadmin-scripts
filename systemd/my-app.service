[Unit]
Description=Resource monitoring web service
Requires=docker.service restore-storage.service
After=docker.service restore-storage.service

[Service]
ExecStartPre=/usr/bin/mountpoint -q /mnt/logs
ExecStart=/usr/bin/docker start -a my-app
ExecStop=/usr/bin/docker stop -t 5 my-app
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
